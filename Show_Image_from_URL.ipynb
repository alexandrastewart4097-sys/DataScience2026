
from skimage import io as io
import matplotlib.pyplot as plt
     

def plot(x):
    fig, ax = plt.subplots()
    im = ax.imshow(x, cmap = 'gray')
    ax.axis('off')
    fig.set_size_inches(8, 8)
    plt.show()
     

image = io.imread("https://www.vecteezy.com/free-photos/nature-wallpaper")
plot(image)
     
